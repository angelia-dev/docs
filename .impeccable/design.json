      "html": "<div class=\"ds-stage\"><a class=\"ds-btn ds-btn-docs\" href=\"#\">Quickstart</a></div>",
      "css": ":host{--ag-midnight:#14123a;--ag-ink:#1e1b4b;--ag-indigo:#4338ca;--ag-indigo-soft:#c7d2fe;--ag-gold-deep:#b45309;--ag-gold:#f59e0b;--ag-gold-mid:#fbbf24;--ag-canary:#fde68a;--ag-canary-pale:#fef6d3;--ag-paper:#fffcef;--ag-flash:#e0452b;--ag-font-text:'Archivo',ui-sans-serif,system-ui,sans-serif;--ag-font-mono:'JetBrains Mono',ui-monospace,Menlo,monospace;}.ds-btn{display:inline-flex;align-items:center;gap:.55rem;padding:.85rem 1.35rem;font-family:var(--ag-font-text);font-weight:750;font-stretch:85%;font-size:1rem;letter-spacing:.01em;text-decoration:none;border:0;border-radius:2px;cursor:pointer;transition:transform 160ms cubic-bezier(.2,.8,.2,1),background-color 160ms,color 160ms,box-shadow 160ms;}.ds-btn svg{width:1.1em;height:1.1em}.ds-btn:focus-visible{outline:2px solid var(--ag-canary);outline-offset:3px}.ds-stage{background:var(--ag-paper);padding:1.5rem}.ds-btn-docs{background:var(--ag-ink);color:#fff;font-weight:700;font-size:.8rem;padding:.6rem 1.2rem}.ds-btn-docs:hover{background:var(--ag-indigo)}"
