    {
      "name": "Gold Button",
      "kind": "button",
      "refersTo": "button-gold",
      "description": "The one primary action per block, on midnight or ink.",
      "html": "<div class=\"ds-stage\"><a class=\"ds-btn ds-btn-gold\" href=\"#\">Start in five minutes <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a></div>",
      "css": ":host{--ag-midnight:#14123a;--ag-ink:#1e1b4b;--ag-indigo:#4338ca;--ag-indigo-soft:#c7d2fe;--ag-gold-deep:#b45309;--ag-gold:#f59e0b;--ag-gold-mid:#fbbf24;--ag-canary:#fde68a;--ag-canary-pale:#fef6d3;--ag-paper:#fffcef;--ag-flash:#e0452b;--ag-font-text:'Archivo',ui-sans-serif,system-ui,sans-serif;--ag-font-mono:'JetBrains Mono',ui-monospace,Menlo,monospace;}.ds-btn{display:inline-flex;align-items:center;gap:.55rem;padding:.85rem 1.35rem;font-family:var(--ag-font-text);font-weight:750;font-stretch:85%;font-size:1rem;letter-spacing:.01em;text-decoration:none;border:0;border-radius:2px;cursor:pointer;transition:transform 160ms cubic-bezier(.2,.8,.2,1),background-color 160ms,color 160ms,box-shadow 160ms;}.ds-btn svg{width:1.1em;height:1.1em}.ds-btn:focus-visible{outline:2px solid var(--ag-canary);outline-offset:3px}.ds-stage{background:var(--ag-midnight);padding:1.5rem}.ds-btn-gold{background:var(--ag-gold-mid);color:var(--ag-midnight);box-shadow:0 6px 18px -8px rgba(251,191,36,.6)}.ds-btn-gold:hover{background:var(--ag-canary);transform:translateY(-1px)}"
